{
    "name": "easy-idb",
    "version": "1.0.1",
    "private": true,
    "description": "JavaScript library that provide high level and easy to use API to the IndexedDB feaure.",
    "keywords": [
        "javascript",
        "indexeddb",
        "idb",
        "storage"
    ],
    "license": "LGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/henrikszucs/easy-idb"
    },
    "bugs": "https://github.com/henrikszucs/easy-idb/issues",
    "maintainers": [
        {
            "name": "Henrik Szucs",
            "email": "henrikszucs6@gmail.com"
        }
    ],
    "scripts": {
        "build": "node dev/build.js",
        "dev-server": "node dev/dev-server.js",
        "test": "node --test \"tests/**/*.test.js\""
    },
    "type": "module",
    "main": "./dist/idb.cjs",
    "module": "./dist/idb.js",
    "exports": {
        ".": {
            "import": "./dist/idb.js",
            "require": "./dist/idb.cjs"
        },
        "./min": "./dist/idb.min.js",
        "./iife": "./dist/idb.iife.min.js",
        "./src": "./src/idb.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src"
    ],
    "devDependencies": {
        "easy-mime": "github:henrikszucs/easy-mime#v1.1.0",
        "esbuild": "^0.28.2",
        "fake-indexeddb": "^6.2.5"
    }
}
